# Materials Project API key (get from https://materialsproject.org -> Dashboard -> API)
MP_API_KEY=your_mp_api_key_here

# MACE-MP-0 model size: "small", "medium", or "large" (auto-downloads on first use)
# Or set to a local checkpoint file path
MACE_MODEL=medium

# Device for MACE: "cpu" or "cuda"
MACE_DEVICE=cpu

# CrystaLLM checkpoint path (leave empty to skip generation)
CRYSTALLM_CHECKPOINT_PATH=crystallm_repo/models/crystallm_v1_small/ckpt.pt
